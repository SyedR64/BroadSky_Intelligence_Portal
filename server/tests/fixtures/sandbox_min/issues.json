{
 "issues": [
  {
   "id": "no_heat",
   "label": "No heat",
   "trades": [
    "hvac"
   ],
   "match": [
    "no heat",
    "not heating",
    "furnace (won.?t|not) (start|run|light)",
    "runs a few seconds",
    "cold (house|inside)",
    "heat (is )?(out|off)"
   ],
   "focus": [
    "furnace",
    "boiler",
    "heat_pump",
    "gas_shutoff",
    "service_switch"
   ],
   "causes": [
    {
     "text": "Hot-surface ignitor has failed",
     "w": 3,
     "boost": {
      "kind": "furnace",
      "age_over": 10,
      "fuel": "gas",
      "rec_word": "ignitor"
     }
    },
    {
     "text": "Dirty flame sensor shuts the burner down",
     "w": 2,
     "boost": {
      "kind": "furnace",
      "fuel": "gas"
     }
    },
    {
     "text": "Thermostat, power or a tripped furnace switch",
     "w": 2
    },
    {
     "text": "Clogged filter tripping the high-limit switch",
     "w": 1
    }
   ],
   "check": [
    "Thermostat set to heat and calling",
    "Furnace switch and breaker on",
    "Board light code",
    "Filter"
   ],
   "bring": [
    {
     "text": "Universal hot-surface ignitor",
     "part": "ign-hsi"
    },
    {
     "text": "Flame sensor and emery cloth",
     "part": "flame-sensor"
    },
    {
     "text": "Multimeter"
    },
    {
     "text": "3 to 5 amp fuse",
     "part": "fuse-3a"
    },
    {
     "text": "16x25 filters",
     "part": "filter-1625"
    }
   ],
   "safety": [
    "gas"
   ],
   "offers": [
    "ignitor",
    "diag",
    "tuneup",
    "club_total",
    "replace_furnace"
   ]
  },
