 "styles": {
  "brief": {
   "label": "Three lines, one action",
   "chat": "Three lines: the answer, the number that matters with its source, then Recommend: and one action.",
   "voice": "Three spoken sentences, the last one a recommendation."
  },
  "analyst": {
   "label": "Full numbers, sourced",
   "chat": "Full numbers with units and [n] on each; a small table is fine; up to 300 words.",
   "voice": "Lead with the number, then the two drivers; under 80 words."
  },
  "operator": {
   "label": "Status, risks, next",
   "chat": "Three short labelled parts: Status, Risks, Next steps; under 180 words.",
   "voice": "Status in one sentence, the top risk, the next step."
  },
  "desk": {
   "label": "Short, with drafts",
   "chat": "Two to four lines; offer a draft when an action fits.",
   "voice": "Two sentences; offer a draft."
  },
  "field": {
   "label": "Under 30 seconds",
   "chat": "For a phone in a driveway: at most five short lines, under 75 words. First where the equipment for this issue is and its shutoff, then the likely cause and first check, what to bring, one offer. No headings.",
   "voice": "Under 30 seconds, about 70 words, same order; say \"from our records\" or \"likely\" for each location; end with \"The sketch is on your screen.\" when a sketch was drawn."
  }
 },
